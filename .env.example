# ============================================
# Bunga Trader v2 - Environment Configuration
# Copy to .env and fill REAL values
# ============================================

# --- Telegram (get from https://my.telegram.org) ---
TG_API_ID=123456
TG_API_HASH=abcdef1234567890abcdef1234567890
TG_PHONE=+1234567890

# --- Channels to monitor (comma-separated) ---
# Use your gold-signal channels here. The app is gold-only now.
SIGNAL_CHANNELS=gold_signals_channel,-1001234567890

# --- MT5 Account ---
MT5_LOGIN=12345678
MT5_PASSWORD=your_password
MT5_SERVER=YourBroker-Server

# --- Risk Settings ---
DEFAULT_RISK_PERCENT=1.0
MAX_LOT=1.0
MAX_DAILY_LOSS_PERCENT=5.0
DAILY_PROFIT_TARGET_PERCENT=5.0
MIN_RR_RATIO=1.0
SIGNAL_MAX_AGE_MINUTES=30

# --- Application ---
DEMO_BALANCE=10000.0
API_KEY=
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///data/bunga.db

# --- Free LLM APIs (get from:)
# Google AI Studio: https://aistudio.google.com/app/apikey
# Groq: https://console.groq.com/keys
# OpenRouter: https://openrouter.ai/keys
GOOGLE_API_KEY=your_google_key_here
GROQ_API_KEY=your_groq_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# --- Market Data API (for strategy engine) ---
# At least one required for fetching live prices
# Alpha Vantage: https://www.alphavantage.co/support/#api-key (free, 5 req/min)
ALPHA_VANTAGE_API_KEY=
# Twelve Data: https://twelvedata.com/apikey (free tier ~800 req/day)
TWELVEDATA_API_KEY=

# --- Quadapt ML Trader Strategy ---
STRATEGY_ENABLED=true
STRATEGY_SYMBOLS=XAUUSD,EURUSD,GBPUSD
STRATEGY_POLL_INTERVAL=60
STRATEGY_ENVELOPE_MODE=Consensus
STRATEGY_QUALITY_THRESHOLD=65
